# https://wakatime.com/settings/api-key
WAKATIME_API_KEY=waka_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Any token with read:user. In CI the workflow falls back to the
# automatic GITHUB_TOKEN, which only counts public contributions.
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional, defaults to J-Pster
GITHUB_LOGIN=J-Pster
